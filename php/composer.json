            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "palindromechecker",
        "palindrome",
        "palindrome checker",
        "text analysis",
        "word games",
        "text validation"
    ],
    "homepage": "https://apiverve.com/marketplace/palindromechecker?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/palindromechecker",
        "source": "https://github.com/apiverve/palindromechecker-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Palindromechecker\\": "src/"
        }
    },
    "autoload-dev": {
